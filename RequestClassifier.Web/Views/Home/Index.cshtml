@{
    ViewData["Title"] = "Ana Sayfa";
}

<section class="hero-section text-white">
    <div class="container py-5">

        <div class="row align-items-center g-5">

            <div class="col-lg-7">

                <span class="badge bg-light text-primary px-3 py-2 mb-3">
                    Belediye Dijital Hizmetleri
                </span>

                <h1 class="hero-title mb-4">
                    Talep, şikâyet ve önerilerinizi kolayca iletin
                </h1>

                <p class="hero-description mb-4">
                    Belediye hizmetleriyle ilgili taleplerinizi oluşturabilir,
                    sistem tarafından ilgili birime yönlendirilmesini sağlayabilir
                    ve başvuru numaranızla süreci takip edebilirsiniz.
                </p>

                <div class="d-flex flex-wrap gap-3">

                    <a asp-controller="Requests"
                       asp-action="Create"
                       class="btn btn-light btn-lg text-primary fw-semibold px-4">

                        <i class="bi bi-plus-circle me-2"></i>
                        Yeni Talep Oluştur
                    </a>

                    <a asp-controller="Requests"
                       asp-action="Track"
                       class="btn btn-outline-light btn-lg fw-semibold px-4">

                        <i class="bi bi-search me-2"></i>
                        Talebimi Sorgula
                    </a>

                </div>

            </div>

            <div class="col-lg-5">

                <div class="card border-0 shadow-lg rounded-4">
                    <div class="card-body p-4 p-lg-5">

                        <div class="action-icon bg-primary-subtle text-primary mb-4">
                            <i class="bi bi-chat-left-text"></i>
                        </div>

                        <h2 class="h4 text-dark fw-bold">
                            Hızlı ve kolay başvuru
                        </h2>

                        <p class="text-secondary mb-4">
                            Talebinizi birkaç dakika içinde oluşturun.
                            Sistem, içeriği analiz ederek uygun kategori ve
                            belediye birimini belirlesin.
                        </p>

                        <ul class="list-unstyled text-dark mb-0">

                            <li class="mb-3">
                                <i class="bi bi-check-circle-fill text-success me-2"></i>
                                Kolay başvuru formu
                            </li>

                            <li class="mb-3">
                                <i class="bi bi-check-circle-fill text-success me-2"></i>
                                Otomatik sınıflandırma
                            </li>

                            <li>
                                <i class="bi bi-check-circle-fill text-success me-2"></i>
                                Başvuru numarasıyla takip
                            </li>

                        </ul>

                    </div>
                </div>

            </div>

        </div>
    </div>
</section>

<section class="py-5 bg-white">
    <div class="container">

        <div class="text-center mb-5">
            <h2 class="fw-bold">
                Nasıl çalışır?
            </h2>

            <p class="text-secondary mb-0">
                Talebinizi üç basit adımda belediyemize iletin.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="process-step">
                    <span class="process-number mb-3">1</span>

                    <h3 class="h5 fw-bold">
                        Talebinizi oluşturun
                    </h3>

                    <p class="text-secondary mb-0">
                        İletişim bilgilerinizi, talep başlığını ve açıklamasını girin.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="process-step">
                    <span class="process-number mb-3">2</span>

                    <h3 class="h5 fw-bold">
                        İlgili birime yönlendirilsin
                    </h3>

                    <p class="text-secondary mb-0">
                        Sistem talebinizi analiz ederek uygun kategori ve birimi belirler.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="process-step">
                    <span class="process-number mb-3">3</span>

                    <h3 class="h5 fw-bold">
                        Süreci takip edin
                    </h3>

                    <p class="text-secondary mb-0">
                        Başvuru numaranız ve e-posta adresinizle güncel durumu görüntüleyin.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>