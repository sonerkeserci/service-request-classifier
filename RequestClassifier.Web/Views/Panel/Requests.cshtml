@{
	ViewData["Title"] = "Talepler";
}

<!-- Page header -->
<div class="d-flex justify-content-between align-items-center mb-4">
	<div>
		<h2 class="mb-1">Talepler</h2>
		<p class="text-muted mb-0">
			Sisteme gönderilen hizmet taleplerini görüntüleyin.
		</p>
	</div>
	<!-- Reloads the request list without refreshing the entire page -->
	<button class="btn btn-outline-primary" onclick="loadRequests()">
		Yenile
	</button>
</div>

<!-- This area is displayed while the request list is being loaded from the server. -->
<div id="loadingArea" class="text-center py-5">
	<div class="spinner-border text-primary" role="status">
		<span class="visually-hidden">Yükleniyor...</span>
	</div>

	<p class="text-muted mt-3 mb-0">
		Talepler yükleniyor...
	</p>
</div>

<!-- API or network errors are displayed in this area. It is hidden by default. -->
<div id="errorArea" class="alert alert-danger d-none"></div>

<!-- The request table is hidden initially. It becomes visible after the requests are loaded successfully. -->
<div id="requestTableArea" class="card border-0 shadow-sm d-none">
	<div class="card-body p-0">
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead class="table-light">
					<tr>
						<th>Talep No</th>
						<th>Başlık</th>
						<th>Vatandaş</th>
						<th>Tahmin Edilen Kategori</th>
						<th>Atanan Kategori</th>
						<th>Durum</th>
						<th>Tahmin Skoru</th>
						<th>Tarih</th>
						<th class="text-end">İşlem</th>
					</tr>
				</thead>

				<!--  Request rows will be inserted here dynamically by JavaScript.  -->
				<tbody id="requestTableBody">
				</tbody>
			</table>
		</div>
	</div>
</div>

<!-- This area is displayed when the API returns an empty request list. -->
<div id="emptyArea" class="alert alert-info d-none">
	Görüntülenecek talep bulunamadı.
</div>

<!-- Displays the selected service request details in a panel opening from the right side. -->
<div class="offcanvas offcanvas-end"
	 tabindex="-1"
	 id="requestDetailOffcanvas"
	 aria-labelledby="requestDetailOffcanvasLabel">

	<div class="offcanvas-header border-bottom">
		<div>
			<h5 class="offcanvas-title"
				id="requestDetailOffcanvasLabel">

				Talep Detayı
			</h5>

			<small id="detailRequestNumber"
				   class="text-muted">
			</small>
		</div>

		<button type="button"
				class="btn-close"
				data-bs-dismiss="offcanvas"
				aria-label="Kapat">
		</button>
	</div>

	<div class="offcanvas-body">

		<!-- Displayed while the selected request is loading -->
		<div id="detailLoadingArea"
			 class="text-center py-5 d-none">

			<div class="spinner-border text-primary"
				 role="status">

				<span class="visually-hidden">
					Yükleniyor...
				</span>
			</div>

			<p class="text-muted mt-3">
				Talep detayı yükleniyor...
			</p>
		</div>

		<!-- Displays errors received while loading request details -->
		<div id="detailErrorArea"
			 class="alert alert-danger d-none">
		</div>

		<!-- Contains the selected service request information -->
		<div id="detailContentArea"
			 class="d-none">

			<div id="lowConfidenceWarning"
				 class="alert alert-warning d-none">

				<strong>
					Manuel inceleme gerekli
				</strong>

				<div class="mt-1">
					Bu talep belediye hizmetleriyle ilgisiz olabilir
					veya sınıflandırma sonucu yeterince güvenilir olmayabilir.
				</div>
			</div>

			<h5 id="detailTitle" class="mb-2"></h5>

			<p id="detailDescription"
			   class="text-muted mb-4">
			</p>

			<div class="row g-3">
				<div class="col-6">
					<small class="text-muted d-block">
						Vatandaş
					</small>

					<strong id="detailRequester">
						-
					</strong>
				</div>

				<div class="col-6">
					<small class="text-muted d-block">
						Durum
					</small>

					<div id="detailStatus">
						-
					</div>
				</div>

				<!-- The predicted department is the primary routing information.
     The predicted category is displayed as secondary information. -->
				<div class="col-12">
					<div class="p-3 rounded-3 bg-light border">
						<small class="text-muted d-block">
							Tahmin edilen birim
						</small>

						<strong id="detailPredictedDepartment"
								class="d-block fs-5 mt-1">
							-
						</strong>

						<small class="text-muted d-block mt-2">
							Kategori
						</small>

						<span id="detailPredictedCategory">
							-
						</span>
					</div>
				</div>

				<!-- The assigned department is the actual destination of the request.
     The assigned category is displayed as secondary information. -->
				<div class="col-12">
					<div class="p-3 rounded-3 border">
						<small class="text-muted d-block">
							Atanan birim
						</small>

						<strong id="detailAssignedDepartment"
								class="d-block fs-5 mt-1">
							Henüz atanmadı
						</strong>

						<small class="text-muted d-block mt-2">
							Kategori
						</small>

						<span id="detailAssignedCategory">
							-
						</span>
					</div>
				</div>

				<div class="col-6">
					<div class="d-flex align-items-center gap-1">
						<small class="text-muted">
							Tahmin skoru
						</small>

						<i class="bi bi-question-circle text-secondary"
						   data-bs-toggle="tooltip"
						   data-bs-placement="top"
						   title="Modelin oluşturduğu kategori tahmin vektöründeki en yüksek değerli elemanın skorudur. Tahmin skoru 0.45'ten ve tahmin güven farkı 0.20'den büyükse ilgili birime otomatik atama gerçekleşir.">
						</i>
					</div>

					<div id="detailPredictionScore">
						-
					</div>
				</div>

				<div class="col-6">
					<div class="d-flex align-items-center gap-1">
						<small class="text-muted">
							Tahmin güven farkı
						</small>

						<i class="bi bi-question-circle text-secondary"
						   data-bs-toggle="tooltip"
						   data-bs-placement="top"
						   title="Tahmin güven farkı, en yüksek iki kategori tahmini arasındaki farktır. Tahmin güven farkı 0.20'den ve tahmin skoru 0.45'ten büyükse ilgili birime otomatik atama gerçekleşir.">
						</i>
					</div>

					<strong id="detailPredictionMargin">
						-
					</strong>
				</div>

				<div class="col-6">
					<small class="text-muted d-block">
						Otomatik atama
					</small>

					<strong id="detailAutoAssignment">
						-
					</strong>
				</div>

				<div class="col-6">
					<small class="text-muted d-block">
						Oluşturulma tarihi
					</small>

					<strong id="detailCreatedAt">
						-
					</strong>
				</div>
			</div>

			<hr class="my-4">

			<div>
				<small class="text-muted d-block">
					E-posta
				</small>

				<span id="detailEmail">
					-
				</span>
			</div>

			<div class="mt-3">
				<small class="text-muted d-block">
					Telefon
				</small>

				<span id="detailPhone">
					-
				</span>
			</div>

			<hr class="my-4">

			<!-- Allows Admin and Employee users to update the request status. -->
			<div>
				<h6 class="fw-bold mb-3">
					Durum Güncelle
				</h6>

				<!-- Displays success or error messages after status update. -->
				<div id="statusUpdateMessage"
					 class="alert d-none">
				</div>

				<div class="mb-3">
					<label for="newStatusSelect"
						   class="form-label">
						Yeni durum
					</label>

					<select id="newStatusSelect"
							class="form-select">

						<option value="">
							Durum seçin
						</option>

						<option value="1">
							Alındı
						</option>

						<option value="2">
							Sınıflandırıldı
						</option>

						<option value="3">
							Birime Atandı
						</option>

						<option value="4">
							İşleme Alındı
						</option>

						<option value="5">
							Çözüldü
						</option>

						<option value="6">
							Kapatıldı
						</option>

						<option value="7">
							Reddedildi
						</option>
					</select>
				</div>

				<div class="mb-3">
					<label for="statusDescription"
						   class="form-label">
						Açıklama
					</label>

					<textarea id="statusDescription"
							  class="form-control"
							  rows="3"
							  placeholder="Durum değişikliği hakkında açıklama girin..."></textarea>
				</div>

				<button type="button"
						id="updateStatusButton"
						class="btn btn-primary w-100"
						onclick="updateRequestStatus()">

					Durumu Güncelle
				</button>
			</div>

			<hr class="my-4">

			<!-- Status history remains collapsed until the user opens it. -->
			<div>
				<button type="button"
						id="historyToggleButton"
						class="btn btn-outline-secondary w-100 d-flex justify-content-between align-items-center"
						data-bs-toggle="collapse"
						data-bs-target="#requestHistoryCollapse"
						aria-expanded="false"
						aria-controls="requestHistoryCollapse">

					<span>
						<i class="bi bi-clock-history me-2"></i>
						Durum Geçmişini Göster
					</span>

					<i class="bi bi-chevron-down"></i>
				</button>

				<div class="collapse mt-3"
					 id="requestHistoryCollapse">

					<!-- Displayed while history records are loading. -->
					<div id="historyLoadingArea"
						 class="text-center py-4 d-none">

						<div class="spinner-border spinner-border-sm text-primary"
							 role="status">
						</div>

						<span class="text-muted ms-2">
							Durum geçmişi yükleniyor...
						</span>
					</div>

					<!-- Displays history loading errors. -->
					<div id="historyErrorArea"
						 class="alert alert-danger d-none">
					</div>

					<!-- Displays an empty message when no history exists. -->
					<div id="historyEmptyArea"
						 class="alert alert-light border d-none">

						Durum geçmişi bulunamadı.
					</div>

					<!-- History cards will be generated here. -->
					<div id="historyList">
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>

		// Stores the ID of the request currently opened in the offcanvas.
		let selectedRequestId = null;
		/*
		 * Runs after the HTML document is fully loaded.
		 * Automatically loads the request list when the page opens.
		 */
		document.addEventListener("DOMContentLoaded", function() {
			loadRequests();

			document
				.querySelectorAll('[data-bs-toggle="tooltip"]')
				.forEach(element => {
					new bootstrap.Tooltip(element);
				});

			/*
			 * Loads history only when the collapse area is opened.
			 * This prevents an unnecessary request every time
			 * the detail offcanvas opens.
			 */
			const historyCollapse =
				document.getElementById("requestHistoryCollapse");

			historyCollapse.addEventListener(
				"show.bs.collapse",
				function() {
					loadRequestHistory();
				}
			);
		});

		/*
		 * Loads service requests from the PanelController.
		 *
		 * The browser sends a GET request to:
		 * /Panel/GetRequests
		 *
		 * The controller will call the API by using the JWT token
		 * stored in the session.
		 */
		async function loadRequests() {

			// Get references to the HTML elements used by the page.
			const loadingArea = document.getElementById("loadingArea");
			const errorArea = document.getElementById("errorArea");
			const tableArea = document.getElementById("requestTableArea");
			const emptyArea = document.getElementById("emptyArea");
			const tableBody = document.getElementById("requestTableBody");

			/*
			 * Reset the page before starting a new request.
			 *
			 * Show the loading spinner.
			 * Hide the previous error, table and empty-message areas.
			 * Clear previously generated table rows.
			 */
			loadingArea.classList.remove("d-none");
			errorArea.classList.add("d-none");
			tableArea.classList.add("d-none");
			emptyArea.classList.add("d-none");

			tableBody.innerHTML = "";

			try {
				/*
				 * Sends a request to the MVC controller.
				 *
				 * This does not directly call the API project.
				 * PanelController receives this request and then
				 * calls the API with the user's JWT token.
				 */
				const response = await fetch("/Panel/GetRequests");

				/*
				 * HTTP 401 means that the user is not authorized.
				 *
				 * This may happen when:
				 * - The session does not contain a token.
				 * - The token has expired.
				 * - The API rejects the token.
				 */
				if (response.status === 401) {
					window.location.href = "/Account/Login";
					return;
				}

				
				/*
				 * response.ok is true for successful HTTP status codes
				 * between 200 and 299.
				 */
				if (!response.ok) {
					throw new Error("Talepler alınırken bir hata oluştu.");
				}

				/*
				 * Converts the JSON response into a JavaScript array.
				 *
				 * Expected structure:
				 *
				 * [
				 *   {
				 *     id: 1,
				 *     requestNumber: "REQ-2026-0001",
				 *     title: "Yolda çukur var",
				 *     requesterFirstName: "Ahmet",
				 *     requesterLastName: "Yılmaz",
				 *     predictedCategoryName: "Yol Bakım",
				 *     assignedCategoryName: "Yol Bakım",
				 *     status: 2,
				 *     predictionScore: 0.87,
				 *     isLowConfidence: false,
				 *     createdAt: "2026-07-31T10:30:00"
				 *   }
				 * ]
				 */
				const requests = await response.json();

				/*
				 * Show the empty message when the API returns
				 * null, undefined or an empty array.
				 */
				if (!requests || requests.length === 0) {
					emptyArea.classList.remove("d-none");
					return;
				}

				/*
				 * Creates one table row for each service request.
				 */
				requests.forEach(request => {
					const row = document.createElement("tr"); // Create a new HTML table row.

					/*
					 * Fill the row using the request data.
					 *
					 * escapeHtml is used for user-provided text
					 * to reduce the risk of HTML injection.
					 */
					row.innerHTML = `
												<td>
													<strong>${escapeHtml(request.requestNumber ?? "-")}</strong>
												</td>

												<td>
													${escapeHtml(request.title ?? "-")}
												</td>

												<td>
													${getRequesterName(request)}
												</td>

												<td>
													${escapeHtml(request.predictedCategoryName ?? "-")}
												</td>

												<td>
													${escapeHtml(request.assignedCategoryName ?? "-")}
												</td>

												<td>
													${getStatusBadge(request.status)}
												</td>

												<td>
													${getPredictionScore(request)}
												</td>

												<td>
													${formatDate(request.createdAt)}
												</td>

												<td class="text-end">
													<button
														type="button"
														class="btn btn-sm btn-primary"
														onclick="openRequestDetail(${request.id})">
														Detay
													</button>
												</td>
											`;

					tableBody.appendChild(row);	// Add the generated row to the table body.
				});

				tableArea.classList.remove("d-none");	// Display the table after all rows are generated.
			}
			catch (error) {
				/*
				* Displays errors caused by:
				* - Network problems
				* - Invalid JSON
				* - API errors
				* - Controller errors
				*/
				errorArea.textContent = error.message;
				errorArea.classList.remove("d-none");
			}
			finally {
				/*
				 * The finally block always runs,
				 * whether the request succeeds or fails.
				 */
				loadingArea.classList.add("d-none");
			}
		}

		/*
		* Opens the offcanvas panel and loads the selected
		* service request details from PanelController.
		*/
		async function openRequestDetail(requestId) {

			// Remember which request is currently opened.
			selectedRequestId = requestId;

			const offcanvasElement =
				document.getElementById("requestDetailOffcanvas");

			const detailOffcanvas =
				bootstrap.Offcanvas.getOrCreateInstance(
					offcanvasElement
				);

			const loadingArea =
				document.getElementById("detailLoadingArea");

			const errorArea =
				document.getElementById("detailErrorArea");

			const contentArea =
				document.getElementById("detailContentArea");

			// Open the panel immediately so the user sees
			// the loading state without waiting for the API.
			detailOffcanvas.show();

			loadingArea.classList.remove("d-none");
			errorArea.classList.add("d-none");
			contentArea.classList.add("d-none");

			clearRequestDetail();

			try {
				const response = await fetch(
					`/Panel/GetRequestDetail?id=${requestId}`
				);

				if (response.status === 401) {
					window.location.href = "/Account/Login";
					return;
				}

				if (response.status === 403) {
					throw new Error(
						"Bu talebi görüntüleme yetkiniz bulunmuyor."
					);
				}

				if (response.status === 404) {
					throw new Error(
						"Talep bulunamadı veya bu talebe erişim yetkiniz yok."
					);
				}

				if (!response.ok) {
					throw new Error(
						"Talep detayı alınırken bir hata oluştu."
					);
				}

				const request = await response.json();

				fillRequestDetail(request);

				contentArea.classList.remove("d-none");
			}
			catch (error) {
				errorArea.textContent =
					error.message ??
					"Beklenmeyen bir hata oluştu.";

				errorArea.classList.remove("d-none");
			}
			finally {
				loadingArea.classList.add("d-none");
			}
		}

		/*
		* Clears values left from the previously opened request.
		*/
		function clearRequestDetail() {
			document.getElementById(
				"detailRequestNumber"
			).textContent = "";

			document.getElementById(
				"detailTitle"
			).textContent = "";

			document.getElementById(
				"detailDescription"
			).textContent = "";

			document.getElementById(
				"detailRequester"
			).textContent = "-";

			document.getElementById(
				"detailStatus"
			).innerHTML = "-";

			document.getElementById(
				"detailPredictedDepartment"
			).textContent = "-";

			document.getElementById(
				"detailAssignedDepartment"
			).textContent = "Henüz atanmadı";

			document.getElementById(
				"detailPredictedCategory"
			).textContent = "-";

			document.getElementById(
				"detailAssignedCategory"
			).textContent = "-";

			document.getElementById(
				"detailPredictionScore"
			).innerHTML = "-";

			document.getElementById(
				"detailPredictionMargin"
			).textContent = "-";

			document.getElementById(
				"detailAutoAssignment"
			).textContent = "-";

			document.getElementById(
				"detailCreatedAt"
			).textContent = "-";

			document.getElementById(
				"detailEmail"
			).textContent = "-";

			document.getElementById(
				"detailPhone"
			).textContent = "-";

			document.getElementById(
				"lowConfidenceWarning"
			).classList.add("d-none");

			document.getElementById(
				"historyList"
			).innerHTML = "";

			document.getElementById(
				"historyErrorArea"
			).classList.add("d-none");

			document.getElementById(
				"historyEmptyArea"
			).classList.add("d-none");

			const historyCollapseElement =
				document.getElementById(
					"requestHistoryCollapse"
				);

			const historyCollapse =
				bootstrap.Collapse.getInstance(
					historyCollapseElement
				);

			if (historyCollapse) {
				historyCollapse.hide();
			}
		}

		/*
		 * Writes the API response into the offcanvas elements.
		 */
		function fillRequestDetail(request) {
			document.getElementById(
				"detailRequestNumber"
			).textContent =
				request.requestNumber ?? "-";

			document.getElementById(
				"detailTitle"
			).textContent =
				request.title ?? "-";

			document.getElementById(
				"detailDescription"
			).textContent =
				request.description ?? "-";

			const requesterName = [
				request.requesterFirstName,
				request.requesterLastName
			]
				.filter(Boolean)
				.join(" ");

			document.getElementById(
				"detailRequester"
			).textContent =
				requesterName || "-";

			document.getElementById(
				"detailStatus"
			).innerHTML =
				getStatusBadge(request.status);

			document.getElementById(
				"detailPredictedDepartment"
			).textContent =
				request.predictedDepartmentName ?? "-";

			document.getElementById(
				"detailAssignedDepartment"
			).textContent =
				request.assignedDepartmentName ?? "Henüz atanmadı";
			document.getElementById(
				"detailPredictedCategory"
			).textContent =
				request.predictedCategoryName ?? "-";

			document.getElementById(
				"detailAssignedCategory"
			).textContent =
				request.assignedCategoryName ?? "Henüz atanmadı";

			document.getElementById(
				"detailPredictionScore"
			).innerHTML =
				getPredictionScore(request);

			document.getElementById(
				"detailPredictionMargin"
			).textContent =
				formatScoreMargin(
					request.predictionScoreMargin
				);

			document.getElementById(
				"detailAutoAssignment"
			).textContent =
				request.isAutoAssigned
					? "Evet"
					: "Hayır";

			document.getElementById(
				"detailCreatedAt"
			).textContent =
				formatDate(request.createdAt);

			document.getElementById(
				"detailEmail"
			).textContent =
				request.requesterEmail ?? "-";

			document.getElementById(
				"detailPhone"
			).textContent =
				request.requesterPhoneNumber ?? "-";

			const lowConfidenceWarning =
				document.getElementById(
					"lowConfidenceWarning"
				);

			if (request.isLowConfidence) {
				lowConfidenceWarning.classList.remove(
					"d-none"
				);
			}
			else {
				lowConfidenceWarning.classList.add(
					"d-none"
				);
			}
		}

		/*
		 * Formats the prediction score margin to three decimal places.
		 *
		 * If the value is null or undefined, returns a dash ("-").
		 */
		function formatScoreMargin(value) {
			if (
				value === null ||
				value === undefined
			) {
				return "-";
			}

			return Number(value).toFixed(3);
		}

		/*
		* Sends the selected status and description
		* to PanelController for the currently opened request.
		*/
		async function updateRequestStatus() {
			const statusSelect =
				document.getElementById("newStatusSelect");

			const descriptionInput =
				document.getElementById("statusDescription");

			const messageArea =
				document.getElementById("statusUpdateMessage");

			const updateButton =
				document.getElementById("updateStatusButton");

			const newStatus =
				Number(statusSelect.value);

			if (!selectedRequestId) {
				showStatusMessage(
					"danger",
					"Güncellenecek talep seçilemedi."
				);

				return;
			}

			if (!newStatus) {
				showStatusMessage(
					"warning",
					"Lütfen yeni bir durum seçin."
				);

				return;
			}

			updateButton.disabled = true;
			messageArea.classList.add("d-none");

			try {
				const response = await fetch(
					`/Panel/UpdateRequestStatus?id=${selectedRequestId}`,
					{
						method: "PUT",
						headers: {
							"Content-Type": "application/json"
						},
						body: JSON.stringify({
							newStatus: newStatus,
							description:
								descriptionInput.value.trim()
						})
					}
				);

				if (response.status === 401) {
					window.location.href = "/Account/Login";
					return;
				}

				if (response.status === 404) {
					throw new Error(
						"Talep bulunamadı veya bu talebe erişim yetkiniz yok."
					);
				}

				if (!response.ok) {
					throw new Error(
						"Durum güncellenirken bir hata oluştu."
					);
				}

				showStatusMessage(
					"success",
					"Talep durumu başarıyla güncellendi."
				);

				statusSelect.value = "";
				descriptionInput.value = "";

				// Refresh both the table and the currently opened detail.
				await loadRequests();
				await reloadSelectedRequestDetail();

				const historyCollapseElement =
					document.getElementById(
						"requestHistoryCollapse"
					);

				if (historyCollapseElement.classList.contains("show")) {
					await loadRequestHistory();
				}
			}
			catch (error) {
				showStatusMessage(
					"danger",
					error.message ??
					"Beklenmeyen bir hata oluştu."
				);
			}
			finally {
				updateButton.disabled = false;
			}
		}

		/*
		 * Displays a Bootstrap alert inside the status update area.
		 */
		function showStatusMessage(type, message) {
			const messageArea =
				document.getElementById("statusUpdateMessage");

			messageArea.className =
				`alert alert-${type}`;

			messageArea.textContent = message;
		}

		/*
		 * Reloads the currently opened request after an update.
		 */
		async function reloadSelectedRequestDetail() {
			if (!selectedRequestId) {
				return;
			}

			const response = await fetch(
				`/Panel/GetRequestDetail?id=${selectedRequestId}`
			);

			if (!response.ok) {
				return;
			}

			const request =
				await response.json();

			fillRequestDetail(request);
		}

		/*
		* Loads status history for the request currently opened
		* in the offcanvas.
		*/
		async function loadRequestHistory() {
			if (!selectedRequestId) {
				return;
			}

			const loadingArea =
				document.getElementById(
					"historyLoadingArea"
				);

			const errorArea =
				document.getElementById(
					"historyErrorArea"
				);

			const emptyArea =
				document.getElementById(
					"historyEmptyArea"
				);

			const historyList =
				document.getElementById(
					"historyList"
				);

			loadingArea.classList.remove("d-none");
			errorArea.classList.add("d-none");
			emptyArea.classList.add("d-none");
			historyList.innerHTML = "";

			try {
				const response = await fetch(
					`/Panel/GetRequestHistory?id=${selectedRequestId}`
				);

				if (response.status === 401) {
					window.location.href =
						"/Account/Login";

					return;
				}

				if (response.status === 403) {
					throw new Error(
						"Bu talebin geçmişini görüntüleme yetkiniz bulunmuyor."
					);
				}

				if (response.status === 404) {
					throw new Error(
						"Talep bulunamadı veya bu talebe erişim yetkiniz yok."
					);
				}

				if (!response.ok) {
					throw new Error(
						"Durum geçmişi alınırken bir hata oluştu."
					);
				}

				const histories =
					await response.json();

				if (!histories ||
					histories.length === 0) {

					emptyArea.classList.remove(
						"d-none"
					);

					return;
				}

				histories.forEach(history => {
					const item =
						document.createElement("div");

					item.className =
						"border rounded-3 p-3 mb-3 bg-light";

					const oldStatusText =
						history.oldStatus === null ||
							history.oldStatus === undefined
							? "Başlangıç"
							: getStatusText(
								history.oldStatus
							);

					const newStatusText =
						getStatusText(
							history.newStatus
						);

					item.innerHTML = `
								<div class="d-flex
											justify-content-between
											align-items-start
											gap-3">

									<strong>
										${escapeHtml(oldStatusText)}
										<i class="bi bi-arrow-right mx-1"></i>
										${escapeHtml(newStatusText)}
									</strong>

									<small class="text-muted text-nowrap">
										${formatDate(history.changedAt)}
									</small>
								</div>

								<div class="text-secondary mt-2">
									${escapeHtml(
						history.description ||
						"Açıklama girilmedi."
					)}
								</div>
							`;

					historyList.appendChild(item);
				});
			}
			catch (error) {
				errorArea.textContent =
					error.message ??
					"Beklenmeyen bir hata oluştu.";

				errorArea.classList.remove(
					"d-none"
				);
			}
			finally {
				loadingArea.classList.add(
					"d-none"
				);
			}
		}

		/*
		 * Returns only the Turkish status text without
		 * generating a Bootstrap badge.
		 */
		function getStatusText(status) {
			const statusMap = {
				1: "Alındı",
				2: "Sınıflandırıldı",
				3: "Birime Atandı",
				4: "İşleme Alındı",
				5: "Çözüldü",
				6: "Kapatıldı",
				7: "Reddedildi"
			};

			return statusMap[status] ??
				"Bilinmeyen Durum";
		}

		function getRequesterName(request) {
			const firstName = request.requesterFirstName ?? "";
			const lastName = request.requesterLastName ?? "";
			const fullName = `${firstName} ${lastName}`.trim();

			return escapeHtml(fullName || "-");
		}

		/*
		 * Opens the detail area for a selected request.
		 *
		 * The offcanvas detail panel will be implemented later.
		 * For now, the selected request ID is written to
		 * the browser console.
		 */
		function getPredictionScore(request) {
			if (request.predictionScore === null ||
				request.predictionScore === undefined) {
				return "-";
			}

			const percentage = request.predictionScore * 100;
			const formattedScore = `%${percentage.toFixed(1)}`;

			/*
			* isLowConfidence is calculated in the backend
			* by comparing PredictionScore with
			* MinimumClassificationScoreThreshold.
			*/
			if (request.isLowConfidence) {
				return `
											<span class="badge text-bg-warning">
												${formattedScore}
											</span>
										`;
			}

			return `
										<span class="badge text-bg-success">
											${formattedScore}
										</span>
									`;
		}

		/*
		 * Converts the numeric RequestStatus enum value
		 * into a readable Bootstrap badge.
		 *
		 * Backend enum:
		 * 1: Received
		 * 2: Classified
		 * 3: Assigned
		 * 4: InProgress
		 * 5: Resolved
		 * 6: Closed
		 * 7: Rejected
		 */
		function getStatusBadge(status) {
			const statusMap = {
				1: {
					text: "Alındı",
					cssClass: "text-bg-secondary"
				},
				2: {
					text: "Sınıflandırıldı",
					cssClass: "text-bg-info"
				},
				3: {
					text: "Birime Atandı",
					cssClass: "text-bg-primary"
				},
				4: {
					text: "İşleme Alındı",
					cssClass: "text-bg-warning"
				},
				5: {
					text: "Çözüldü",
					cssClass: "text-bg-success"
				},
				6: {
					text: "Kapatıldı",
					cssClass: "text-bg-dark"
				},
				7: {
					text: "Reddedildi",
					cssClass: "text-bg-danger"
				}
			};

			const statusInfo = statusMap[status] ?? {
				text: "Bilinmiyor",
				cssClass: "text-bg-dark"
			};

			return `
						<span class="badge ${statusInfo.cssClass}">
							${statusInfo.text}
						</span>
					`;
		}

		
		/*
		* Converts the API date value into a Turkish
		* local date and time string.
		*
		* Example:
		* 2026-07-31T10:30:00
		*
		* Result:
		* 31.07.2026 10:30:00
		*/
		function formatDate(dateValue) {
			if (!dateValue) {
				return "-";
			}

			const date = new Date(dateValue);

			if (Number.isNaN(date.getTime())) {
				return "-";
			}

			return date.toLocaleString("tr-TR");
		}

		/*
		 * Encodes special HTML characters.
		 *
		 * This prevents user-entered text from being interpreted
		 * as executable HTML or JavaScript.
		 */
		function escapeHtml(value) {
			return String(value)
				.replaceAll("&", "&amp;")
				.replaceAll("<", "&lt;")
				.replaceAll(">", "&gt;")
				.replaceAll('"', "&quot;")
				.replaceAll("'", "&#039;");
		}
	</script>
}