@using Microsoft.AspNetCore.Http

@{
	ViewData["Title"] = "Talepler";

	var role = Context.Session.GetString("UserRole");
	var isAdmin = role == "Admin";
}

<!-- Page header -->
<div class="d-flex justify-content-between align-items-center mb-4">
	<div>
		<h2 class="mb-1">Talepler</h2>
		<p class="text-muted mb-0">
			Sisteme gönderilen hizmet taleplerini görüntüleyin.
		</p>
	</div>
	<!-- Reloads the request list without refreshing the entire page -->
	<button class="btn btn-outline-primary" onclick="loadRequests()">
		Yenile
	</button>
</div>

<!-- Filters the request list without calling the API again. -->
<div class="card border-0 shadow-sm mb-4">
	<div class="card-body">
		<div class="row g-3 align-items-end">

			<div class="col-md-4">
				<label for="requestSearchInput"
					   class="form-label">
					Ara
				</label>

				<input type="text"
					   id="requestSearchInput"
					   class="form-control"
					   placeholder="Talep no, başlık veya vatandaş ara...">
			</div>

			<div class="col-md-3">
				<label for="statusFilterSelect"
					   class="form-label">
					Durum
				</label>

				<select id="statusFilterSelect"
						class="form-select">

					<option value="">
						Tüm durumlar
					</option>

					<option value="1">Alındı</option>
					<option value="2">Sınıflandırıldı</option>
					<option value="3">Birime Atandı</option>
					<option value="4">İşleme Alındı</option>
					<option value="5">Çözüldü</option>
					<option value="6">Kapatıldı</option>
					<option value="7">Reddedildi</option>
				</select>
			</div>

			<div class="col-md-3">
				<label for="assignmentFilterSelect"
					   class="form-label">
					Atama
				</label>

				<select id="assignmentFilterSelect"
						class="form-select">

					<option value="">
						Tüm talepler
					</option>

					<option value="unassigned">
						Atama bekleyenler
					</option>
				</select>
			</div>

			<div class="col-md-2">
				<button type="button"
						class="btn btn-outline-secondary w-100"
						onclick="clearRequestFilters()">

					Temizle
				</button>
			</div>

		</div>
	</div>
</div>

<!-- This area is displayed while the request list is being loaded from the server. -->
<div id="loadingArea" class="text-center py-5">
	<div class="spinner-border text-primary" role="status">
		<span class="visually-hidden">Yükleniyor...</span>
	</div>

	<p class="text-muted mt-3 mb-0">
		Talepler yükleniyor...
	</p>
</div>

<!-- API or network errors are displayed in this area. It is hidden by default. -->
<div id="errorArea" class="alert alert-danger d-none"></div>

<!-- The request table is hidden initially. It becomes visible after the requests are loaded successfully. -->
<div id="requestTableArea" class="card border-0 shadow-sm d-none">
	<div class="card-body p-0">
		<div class="table-responsive">
			<table class="table table-hover align-middle mb-0">
				<thead class="table-light">
					<tr>
						<th>Talep No</th>
						<th>Başlık</th>
						<th>Vatandaş</th>
						<th>Tahmin Edilen Birim</th>
						<th>Atanan Birim</th>
						<th>Durum</th>
						<th>Tahmin Skoru</th>
						<th>Tarih</th>
						<th class="text-end">İşlem</th>
					</tr>
				</thead>

				<!--  Request rows will be inserted here dynamically by JavaScript.  -->
				<tbody id="requestTableBody">
				</tbody>
			</table>
		</div>
	</div>
</div>

<!-- This area is displayed when the API returns an empty request list. -->
<div id="emptyArea" class="alert alert-info d-none">
	Görüntülenecek talep bulunamadı.
</div>

<!-- Displays the selected service request details in a panel opening from the right side. -->
<div class="offcanvas offcanvas-end"
	 tabindex="-1"
	 id="requestDetailOffcanvas"
	 aria-labelledby="requestDetailOffcanvasLabel">

	<div class="offcanvas-header border-bottom">
		<div>
			<h5 class="offcanvas-title"
				id="requestDetailOffcanvasLabel">

				Talep Detayı
			</h5>

			<small id="detailRequestNumber"
				   class="text-muted">
			</small>
		</div>

		<button type="button"
				class="btn-close"
				data-bs-dismiss="offcanvas"
				aria-label="Kapat">
		</button>
	</div>

	<div class="offcanvas-body">

		<!-- Displayed while the selected request is loading -->
		<div id="detailLoadingArea"
			 class="text-center py-5 d-none">

			<div class="spinner-border text-primary"
				 role="status">

				<span class="visually-hidden">
					Yükleniyor...
				</span>
			</div>

			<p class="text-muted mt-3">
				Talep detayı yükleniyor...
			</p>
		</div>

		<!-- Displays errors received while loading request details -->
		<div id="detailErrorArea"
			 class="alert alert-danger d-none">
		</div>

		<!-- Contains the selected service request information -->
		<div id="detailContentArea"
			 class="d-none">

			<div id="lowConfidenceWarning"
				 class="alert alert-warning d-none">

				<strong>
					Manuel inceleme gerekli
				</strong>

				<div class="mt-1">
					Bu talep belediye hizmetleriyle ilgisiz olabilir
					veya sınıflandırma sonucu yeterince güvenilir olmayabilir.
				</div>
			</div>

			<h5 id="detailTitle" class="mb-2"></h5>

			<p id="detailDescription"
			   class="text-muted mb-4">
			</p>

			<div class="row g-3">
				<div class="col-6">
					<small class="text-muted d-block">
						Vatandaş
					</small>

					<strong id="detailRequester">
						-
					</strong>
				</div>

				<div class="col-6">
					<small class="text-muted d-block">
						Durum
					</small>

					<div id="detailStatus">
						-
					</div>
				</div>

				<!-- The predicted department is the primary routing information.
     The predicted category is displayed as secondary information. -->
				<div class="col-12">
					<div class="p-3 rounded-3 bg-light border">
						<small class="text-muted d-block">
							Tahmin edilen birim
						</small>

						<strong id="detailPredictedDepartment"
								class="d-block fs-5 mt-1">
							-
						</strong>

						<small class="text-muted d-block mt-2">
							Kategori
						</small>

						<span id="detailPredictedCategory">
							-
						</span>
					</div>
				</div>

				<!-- The assigned department is the actual destination of the request.
     The assigned category is displayed as secondary information. -->
				<div class="col-12">
					<div class="p-3 rounded-3 border">
						<small class="text-muted d-block">
							Atanan birim
						</small>

						<strong id="detailAssignedDepartment"
								class="d-block fs-5 mt-1">
							Henüz atanmadı
						</strong>

						<small class="text-muted d-block mt-2">
							Kategori
						</small>

						<span id="detailAssignedCategory">
							-
						</span>
					</div>
				</div>
				<div class="col-6">
					<div class="d-flex align-items-center gap-1">
						<small class="text-muted">
							Tahmin skoru
						</small>

						<i class="bi bi-question-circle text-secondary"
						   data-bs-toggle="tooltip"
						   data-bs-placement="top"
						   title="Modelin en güçlü kategori tahmininin skorudur. Skor yükseldikçe tahmin güçlenir.">
						</i>
					</div>

					<strong id="detailPredictionScore">
						-
					</strong>
				</div>

				<div class="col-6">
					<div class="d-flex align-items-center gap-1">
						<small class="text-muted">
							Tahmin güven farkı
						</small>

						<i class="bi bi-question-circle text-secondary"
						   data-bs-toggle="tooltip"
						   data-bs-placement="top"
						   title="En yüksek iki kategori tahmini arasındaki farktır. Fark büyüdükçe tahmin daha nettir.">
						</i>
					</div>

					<strong id="detailPredictionMargin">
						-
					</strong>
				</div>

				<div class="col-6">
					<small class="text-muted d-block">
						Otomatik atama
					</small>

					<strong id="detailAutoAssignment">
						-
					</strong>
				</div>

				<div class="col-6">
					<small class="text-muted d-block">
						Oluşturulma tarihi
					</small>

					<strong id="detailCreatedAt">
						-
					</strong>
				</div>

				<div class="col-12">
					<button type="button"
							class="btn btn-sm btn-link text-decoration-none px-0"
							data-bs-toggle="collapse"
							data-bs-target="#automaticAssignmentExplanation"
							aria-expanded="false"
							aria-controls="automaticAssignmentExplanation">

						<i class="bi bi-info-circle me-1"></i>
						Otomatik atama nasıl gerçekleşir?
					</button>

					<div class="collapse"
						 id="automaticAssignmentExplanation">

						<div class="p-3 mt-1 border rounded-3 bg-light small">

							<p class="mb-2">
								Sistem; en yüksek tahmin skorunu, ikinci sıradaki
								skoru ve bu iki skor arasındaki güven farkını
								birlikte değerlendirir.
							</p>

							<div class="mb-3 text-muted">
								<strong>Tahmin skoru:</strong>
								Modelin en güçlü kategori sonucudur.
								<br />

								<strong>İkinci skor:</strong>
								Modele göre ikinci en güçlü kategori sonucudur.
								<br />

								<strong>Güven farkı:</strong>
								Birinci ve ikinci skor arasındaki puan farkıdır.
							</div>

							<div class="table-responsive">
								<table class="table table-sm align-middle mb-2">
									<thead>
										<tr>
											<th scope="col">
												En yüksek skor
											</th>

											<th scope="col">
												Otomatik atama koşulu
											</th>
										</tr>
									</thead>

									<tbody>
										<tr>
											<td class="text-nowrap">
												%15 altı
											</td>

											<td>
												Otomatik atama yapılmaz.
												Talep manuel incelemeye bırakılır.
											</td>
										</tr>

										<tr>
											<td class="text-nowrap">
												≥ %15 ve &lt; %24
											</td>

											<td>
												İkinci skor en fazla
												<strong>%10</strong>,
												güven farkı en az
												<strong>7 puan</strong>
												ve birinci skor ikinci skorun en az
												<strong>1,8 katı</strong>
												olmalıdır.
											</td>
										</tr>

										<tr>
											<td class="text-nowrap">
												≥ %24 ve &lt; %35
											</td>

											<td>
												İkinci skor
												<strong>%10 veya altındaysa</strong>,
												güven farkı en az
												<strong>11 puan</strong>
												ve üstünlük en az
												<strong>1,55 kat</strong>
												olmalıdır.

												<div class="mt-1">
													İkinci skor
													<strong>%10'un üzerindeyse</strong>,
													güven farkı en az
													<strong>14 puan</strong>
													ve üstünlük en az
													<strong>1,7 kat</strong>
													olmalıdır.
												</div>
											</td>
										</tr>

										<tr>
											<td class="text-nowrap">
												≥ %35 ve &lt; %45
											</td>

											<td>
												Güven farkı en az
												<strong>9 puan</strong>
												ve birinci skor ikinci skorun en az
												<strong>1,35 katı</strong>
												olmalıdır.
											</td>
										</tr>

										<tr>
											<td class="text-nowrap">
												%45 ve üzeri
											</td>

											<td>
												Güven farkı en az
												<strong>6 puan</strong>
												ve birinci skor ikinci skorun en az
												<strong>1,15 katı</strong>
												olmalıdır.
											</td>
										</tr>
									</tbody>
								</table>
							</div>

							<div class="text-muted">
								Bulunduğu skor aralığındaki koşulların tamamını
								karşılayan talepler tahmin edilen birime otomatik
								atanır. Koşullardan biri karşılanmazsa talep yönetici
								incelemesine bırakılır.
							</div>
						</div>
					</div>
				</div>

				<hr class="my-4">

				<div>
					<small class="text-muted d-block">
						E-posta
					</small>

					<span id="detailEmail">
						-
					</span>
				</div>

				<div class="mt-3">
					<small class="text-muted d-block">
						Telefon
					</small>

					<span id="detailPhone">
						-
					</span>
				</div>

				<hr class="my-4">

				<!-- Allows Admin and Employee users to update the request status. -->
				<div>
					<h6 class="fw-bold mb-3">
						Durum Güncelle
					</h6>

					<!-- Displays success or error messages after status update. -->
					<div id="statusUpdateMessage"
						 class="alert d-none">
					</div>

					<div class="mb-3">
						<label for="newStatusSelect"
							   class="form-label">
							Yeni durum
						</label>

						<select id="newStatusSelect"
								class="form-select">

							<option value="">
								Durum seçin
							</option>

							<option value="1">
								Alındı
							</option>

							<option value="2">
								Sınıflandırıldı
							</option>

							<option value="3">
								Birime Atandı
							</option>

							<option value="4">
								İşleme Alındı
							</option>

							<option value="5">
								Çözüldü
							</option>

							<option value="6">
								Kapatıldı
							</option>

							<option value="7">
								Reddedildi
							</option>
						</select>
					</div>

					<div class="mb-3">
						<label for="statusDescription"
							   class="form-label">
							Açıklama
						</label>

						<textarea id="statusDescription"
								  class="form-control"
								  rows="3"
								  placeholder="Durum değişikliği hakkında açıklama girin..."></textarea>
					</div>

					<button type="button"
							id="updateStatusButton"
							class="btn btn-primary w-100"
							onclick="updateRequestStatus()">

						Durumu Güncelle
					</button>
				</div>

				<hr class="my-4">

				<!-- Status history remains collapsed until the user opens it. -->
				<div>
					<button type="button"
							id="historyToggleButton"
							class="btn btn-outline-secondary w-100 d-flex justify-content-between align-items-center"
							data-bs-toggle="collapse"
							data-bs-target="#requestHistoryCollapse"
							aria-expanded="false"
							aria-controls="requestHistoryCollapse">

						<span>
							<i class="bi bi-clock-history me-2"></i>
							Durum Geçmişini Göster
						</span>

						<i class="bi bi-chevron-down"></i>
					</button>

					<div class="collapse mt-3"
						 id="requestHistoryCollapse">

						<!-- Displayed while history records are loading. -->
						<div id="historyLoadingArea"
							 class="text-center py-4 d-none">

							<div class="spinner-border spinner-border-sm text-primary"
								 role="status">
							</div>

							<span class="text-muted ms-2">
								Durum geçmişi yükleniyor...
							</span>
						</div>

						<!-- Displays history loading errors. -->
						<div id="historyErrorArea"
							 class="alert alert-danger d-none">
						</div>

						<!-- Displays an empty message when no history exists. -->
						<div id="historyEmptyArea"
							 class="alert alert-light border d-none">

							Durum geçmişi bulunamadı.
						</div>

						<!-- History cards will be generated here. -->
						<div id="historyList">
						</div>
					</div>
					@if (isAdmin)
					{
						<hr class="my-4">

						<!-- Admin prediction analysis -->
						<div id="adminPredictionArea">

							<h6 class="fw-bold mb-3">
								Model Tahmin Analizi
							</h6>

							<p class="text-muted small mb-3">
								Model 82 kategori üzerinde değerlendirme yaptı.
								En güçlü 5 tahmin aşağıda listelenmektedir.
							</p>

							<div id="predictionLoadingArea"
								 class="text-center py-3 d-none">

								<div class="spinner-border spinner-border-sm text-primary">
								</div>

								<span class="ms-2">
									Tahmin adayları yükleniyor...
								</span>
							</div>

							<div id="predictionErrorArea"
								 class="alert alert-danger d-none">
							</div>

							<div id="predictionCandidateList">
							</div>

							<div class="mt-4">

								<label class="form-label">
									Manuel Atama
								</label>

								<select id="candidateSelect"
										class="form-select">
								</select>

								<button class="btn btn-success w-100 mt-3"
										onclick="assignCategory()">

									Seçilen Kategoriye Ata
								</button>
							</div>
						</div>
					}
				</div>
			</div>
		</div>
	</div>
</div>


@section Scripts {
	<script>

			// Stores the ID of the request currently opened in the offcanvas.
			let selectedRequestId = null;

	const isAdmin =
		"@isAdmin".toLowerCase() === "true";

			let allRequests = [];

			let predictionCandidates = [];

			/*
				* Runs after the HTML document is fully loaded.
				* Automatically loads the request list when the page opens.
				*/
			document.addEventListener("DOMContentLoaded", function() {

				const queryParameters =
					new URLSearchParams(
						window.location.search
					);

				const assignmentFilter =
					queryParameters.get(
						"assignment"
					);

				if (assignmentFilter === "unassigned") {
					document.getElementById(
						"assignmentFilterSelect"
					).value = "unassigned";
				}


				loadRequests();

				document
					.getElementById("requestSearchInput")
					.addEventListener(
						"input",
						applyRequestFilters
					);

				document
					.getElementById("statusFilterSelect")
					.addEventListener(
						"change",
						applyRequestFilters
					);

				document
					.getElementById("assignmentFilterSelect")
					.addEventListener(
						"change",
						applyRequestFilters
					);

				document
					.querySelectorAll('[data-bs-toggle="tooltip"]')
					.forEach(element => {
						new bootstrap.Tooltip(element);
					});

				/*
					* Loads history only when the collapse area is opened.
					* This prevents an unnecessary request every time
					* the detail offcanvas opens.
					*/
				const historyCollapse =
					document.getElementById("requestHistoryCollapse");

				historyCollapse.addEventListener(
					"show.bs.collapse",
					function() {
						loadRequestHistory();
					}
				);
			});

			/*
				* Loads service requests from the PanelController.
				*
				* The browser sends a GET request to:
				* /Panel/GetRequests
				*
				* The controller will call the API by using the JWT token
				* stored in the session.
				*/
			async function loadRequests() {

				// Get references to the HTML elements used by the page.
				const loadingArea = document.getElementById("loadingArea");
				const errorArea = document.getElementById("errorArea");
				const tableArea = document.getElementById("requestTableArea");
				const emptyArea = document.getElementById("emptyArea");
				const tableBody = document.getElementById("requestTableBody");

				/*
					* Reset the page before starting a new request.
					*
					* Show the loading spinner.
					* Hide the previous error, table and empty-message areas.
					* Clear previously generated table rows.
					*/
				loadingArea.classList.remove("d-none");
				errorArea.classList.add("d-none");
				tableArea.classList.add("d-none");
				emptyArea.classList.add("d-none");

				tableBody.innerHTML = "";

				try {
					/*
						* Sends a request to the MVC controller.
						*
						* This does not directly call the API project.
						* PanelController receives this request and then
						* calls the API with the user's JWT token.
						*/
					const response = await fetch("/Panel/GetRequests");

					/*
						* HTTP 401 means that the user is not authorized.
						*
						* This may happen when:
						* - The session does not contain a token.
						* - The token has expired.
						* - The API rejects the token.
						*/
					if (response.status === 401) {
						window.location.href = "/Account/Login";
						return;
					}

				
					/*
						* response.ok is true for successful HTTP status codes
						* between 200 and 299.
						*/
					if (!response.ok) {
						throw new Error("Talepler alınırken bir hata oluştu.");
					}

					/*
						* Converts the JSON response into a JavaScript array.
						*
						* Expected structure:
						*
						* [
						*   {
						*     id: 1,
						*     requestNumber: "REQ-2026-0001",
						*     title: "Yolda çukur var",
						*     requesterFirstName: "Ahmet",
						*     requesterLastName: "Yılmaz",
						*     predictedCategoryName: "Yol Bakım",
						*     assignedCategoryName: "Yol Bakım",
						*     status: 2,
						*     predictionScore: 0.87,
						*     isLowConfidence: false,
						*     createdAt: "2026-07-31T10:30:00"
						*   }
						* ]
						*/
					const requests = await response.json();

					allRequests = requests ?? [];

					/*
						* Show the empty message when the API returns
						* null, undefined or an empty array.
						*/
					if (allRequests.length === 0) {
						emptyArea.classList.remove("d-none");
						return;
					}

					/*
						* Creates one table row for each service request.
						*/

					applyRequestFilters();
				}

				catch (error) {
					/*
					* Displays errors caused by:
					* - Network problems
					* - Invalid JSON
					* - API errors
					* - Controller errors
					*/
					errorArea.textContent = error.message;
					errorArea.classList.remove("d-none");
				}
				finally {
					/*
						* The finally block always runs,
						* whether the request succeeds or fails.
						*/
					loadingArea.classList.add("d-none");
				}
			}

			function renderRequests(requests) {
				const tableBody =
					document.getElementById("requestTableBody");

				const tableArea =
					document.getElementById("requestTableArea");

				const emptyArea =
					document.getElementById("emptyArea");

				tableBody.innerHTML = "";

				if (!requests || requests.length === 0) {
					tableArea.classList.add("d-none");
					emptyArea.classList.remove("d-none");
					return;
				}

				requests.forEach(request => {
					const row = document.createElement("tr");

					row.innerHTML = `
											<td>
												<strong>
													${escapeHtml(request.requestNumber ?? "-")}
												</strong>
											</td>

											<td>
												${escapeHtml(request.title ?? "-")}
											</td>

											<td>
												${getRequesterName(request)}
											</td>

											<td>
												<div class="fw-semibold">
													${escapeHtml(request.predictedDepartmentName ?? "-")}
												</div>

												<small class="text-muted">
													${escapeHtml(request.predictedCategoryName ?? "-")}
												</small>
											</td>

											<td>
												<div class="fw-semibold">
													${escapeHtml(request.assignedDepartmentName ?? "Henüz atanmadı")}
												</div>

												<small class="text-muted">
													${escapeHtml(request.assignedCategoryName ?? "-")}
												</small>
											</td>

											<td>
												${getStatusBadge(request.status)}
											</td>

											<td>
												${getPredictionScore(request)}
											</td>

											<td>
												${formatDate(request.createdAt)}
											</td>

											<td class="text-end">
												<button
													type="button"
													class="btn btn-sm btn-primary"
													onclick="openRequestDetail(${request.id})">

													Detay
												</button>
											</td>
										`;

					tableBody.appendChild(row);
				});

				emptyArea.classList.add("d-none");
				tableArea.classList.remove("d-none");
			}

			function applyRequestFilters() {
				const searchText =
					document
						.getElementById("requestSearchInput")
						.value
						.trim()
						.toLocaleLowerCase("tr-TR");

				const statusValue =
					document.getElementById(
						"statusFilterSelect"
					).value;

				const assignmentValue =
					document.getElementById(
						"assignmentFilterSelect"
					).value;

				const filteredRequests =
					allRequests.filter(request => {
						const requesterName =
							`${request.requesterFirstName ?? ""} ` +
							`${request.requesterLastName ?? ""}`;

						const searchableText = [
							request.requestNumber,
							request.title,
							request.description,
							requesterName,
							request.predictedDepartmentName,
							request.predictedCategoryName,
							request.assignedDepartmentName,
							request.assignedCategoryName
						]
							.filter(Boolean)
							.join(" ")
							.toLocaleLowerCase("tr-TR");

						const matchesSearch =
							!searchText ||
							searchableText.includes(searchText);

						const matchesStatus =
							!statusValue ||
							String(request.status) === statusValue;

						const isAssigned =
							request.assignedCategoryId !== null &&
							request.assignedCategoryId !== undefined;

						const isWaitingForAssignment =
							!isAssigned &&
							request.status === 2;

						const matchesAssignment =
							!assignmentValue ||
							(
								assignmentValue === "unassigned" &&
								isWaitingForAssignment
							);

						return (
							matchesSearch &&
							matchesStatus &&
							matchesAssignment
						);
					});

				renderRequests(filteredRequests);
			}

			function clearRequestFilters() {
				document.getElementById(
					"requestSearchInput"
				).value = "";

				document.getElementById(
					"statusFilterSelect"
				).value = "";

				document.getElementById(
					"assignmentFilterSelect"
				).value = "";

				renderRequests(allRequests);
			}

			/*
			* Opens the offcanvas panel and loads the selected
			* service request details from PanelController.
			*/
			async function openRequestDetail(requestId) {

				// Remember which request is currently opened.
				selectedRequestId = requestId;

				const offcanvasElement =
					document.getElementById("requestDetailOffcanvas");

				const detailOffcanvas =
					bootstrap.Offcanvas.getOrCreateInstance(
						offcanvasElement
					);

				const loadingArea =
					document.getElementById("detailLoadingArea");

				const errorArea =
					document.getElementById("detailErrorArea");

				const contentArea =
					document.getElementById("detailContentArea");

				// Open the panel immediately so the user sees
				// the loading state without waiting for the API.
				detailOffcanvas.show();

				loadingArea.classList.remove("d-none");
				errorArea.classList.add("d-none");
				contentArea.classList.add("d-none");

				clearRequestDetail();

				try {
					const response = await fetch(
						`/Panel/GetRequestDetail?id=${requestId}`
					);

					if (response.status === 401) {
						window.location.href = "/Account/Login";
						return;
					}

					if (response.status === 403) {
						throw new Error(
							"Bu talebi görüntüleme yetkiniz bulunmuyor."
						);
					}

					if (response.status === 404) {
						throw new Error(
							"Talep bulunamadı veya bu talebe erişim yetkiniz yok."
						);
					}

					if (!response.ok) {
						throw new Error(
							"Talep detayı alınırken bir hata oluştu."
						);
					}

					const request = await response.json();

					fillRequestDetail(request);

					if (isAdmin) {
						await loadPredictionCandidates();
					}


					contentArea.classList.remove("d-none");
				}
				catch (error) {
					errorArea.textContent =
						error.message ??
						"Beklenmeyen bir hata oluştu.";

					errorArea.classList.remove("d-none");
				}
				finally {
					loadingArea.classList.add("d-none");
				}
			}

