			/*
				* Formats the prediction score margin to three decimal places.
				*
				* If the value is null or undefined, returns a dash ("-").
				*/
			function formatScoreMargin(value) {
				if (
					value === null ||
					value === undefined
				) {
					return "-";
				}

				return Number(value).toFixed(3);
			}

			/*
			* Sends the selected status and description
			* to PanelController for the currently opened request.
			*/
			async function updateRequestStatus() {
				const statusSelect =
					document.getElementById("newStatusSelect");

				const descriptionInput =
					document.getElementById("statusDescription");

				const messageArea =
					document.getElementById("statusUpdateMessage");

				const updateButton =
					document.getElementById("updateStatusButton");

				const newStatus =
					Number(statusSelect.value);

				if (!selectedRequestId) {
					showStatusMessage(
						"danger",
						"Güncellenecek talep seçilemedi."
					);

					return;
				}

				if (!newStatus) {
					showStatusMessage(
						"warning",
						"Lütfen yeni bir durum seçin."
					);

					return;
				}

				updateButton.disabled = true;
				messageArea.classList.add("d-none");

				try {
					const response = await fetch(
						`/Panel/UpdateRequestStatus?id=${selectedRequestId}`,
						{
							method: "PUT",
							headers: {
								"Content-Type": "application/json"
							},
							body: JSON.stringify({
								newStatus: newStatus,
								description:
									descriptionInput.value.trim()
							})
						}
					);

					if (response.status === 401) {
						window.location.href = "/Account/Login";
						return;
					}

					if (response.status === 404) {
						throw new Error(
							"Talep bulunamadı veya bu talebe erişim yetkiniz yok."
						);
					}

					if (!response.ok) {
						throw new Error(
							"Durum güncellenirken bir hata oluştu."
						);
					}

					showStatusMessage(
						"success",
						"Talep durumu başarıyla güncellendi."
					);

					statusSelect.value = "";
					descriptionInput.value = "";

					// Refresh both the table and the currently opened detail.
					await loadRequests();
					await reloadSelectedRequestDetail();

					const historyCollapseElement =
						document.getElementById(
							"requestHistoryCollapse"
						);

					if (historyCollapseElement.classList.contains("show")) {
						await loadRequestHistory();
					}
				}
				catch (error) {
					showStatusMessage(
						"danger",
						error.message ??
						"Beklenmeyen bir hata oluştu."
					);
				}
				finally {
					updateButton.disabled = false;
				}
			}

			/*
				* Displays a Bootstrap alert inside the status update area.
				*/
			function showStatusMessage(type, message) {
				const messageArea =
					document.getElementById("statusUpdateMessage");

				messageArea.className =
					`alert alert-${type}`;

				messageArea.textContent = message;
			}

			/*
				* Reloads the currently opened request after an update.
				*/
			async function reloadSelectedRequestDetail() {
				if (!selectedRequestId) {
					return;
				}

				const response = await fetch(
					`/Panel/GetRequestDetail?id=${selectedRequestId}`
				);

				if (!response.ok) {
					return;
				}

				const request =
					await response.json();

				fillRequestDetail(request);
			}

			/*
			* Loads status history for the request currently opened
			* in the offcanvas.
			*/
			async function loadRequestHistory() {
				if (!selectedRequestId) {
					return;
				}

				const loadingArea =
					document.getElementById(
						"historyLoadingArea"
					);

				const errorArea =
					document.getElementById(
						"historyErrorArea"
					);

				const emptyArea =
					document.getElementById(
						"historyEmptyArea"
					);

				const historyList =
					document.getElementById(
						"historyList"
					);

				loadingArea.classList.remove("d-none");
				errorArea.classList.add("d-none");
				emptyArea.classList.add("d-none");
				historyList.innerHTML = "";

				try {
					const response = await fetch(
						`/Panel/GetRequestHistory?id=${selectedRequestId}`
					);

					if (response.status === 401) {
						window.location.href =
							"/Account/Login";

						return;
					}

					if (response.status === 403) {
						throw new Error(
							"Bu talebin geçmişini görüntüleme yetkiniz bulunmuyor."
						);
					}

					if (response.status === 404) {
						throw new Error(
							"Talep bulunamadı veya bu talebe erişim yetkiniz yok."
						);
					}

					if (!response.ok) {
						throw new Error(
							"Durum geçmişi alınırken bir hata oluştu."
						);
					}

					const histories =
						await response.json();

					if (!histories ||
						histories.length === 0) {

						emptyArea.classList.remove(
							"d-none"
						);

						return;
					}

					histories.forEach(history => {
						const item =
							document.createElement("div");

						item.className =
							"border rounded-3 p-3 mb-3 bg-light";

						const newStatusText =
							getStatusText(
								history.newStatus
							);

						item.innerHTML =
							`<div class="d-flex
															justify-content-between
															align-items-start
															gap-3">

															<strong>
																${escapeHtml(newStatusText)}
															</strong>

													<small class="text-muted text-nowrap">
														${formatDate(history.changedAt)}
													</small>
												</div>

												<div class="text-secondary mt-2">
													${escapeHtml(history.description || "Açıklama girilmedi.")}
												</div>`;
						historyList.appendChild(item);
					});
				}
				catch (error) {
					errorArea.textContent =
						error.message ??
						"Beklenmeyen bir hata oluştu.";

					errorArea.classList.remove(
						"d-none"
					);
				}
				finally {
					loadingArea.classList.add(
						"d-none"
					);
				}
			}

			async function loadPredictionCandidates() {

				predictionCandidates = [];

				const loading =
					document.getElementById(
						"predictionLoadingArea");

				const error =
					document.getElementById(
						"predictionErrorArea");

				const list =
					document.getElementById(
						"predictionCandidateList");

				const select =
					document.getElementById(
						"candidateSelect");

				loading.classList.remove("d-none");

				error.classList.add("d-none");

				list.innerHTML = "";

				select.innerHTML = "";

				try {

					const response =
						await fetch(
							`/Panel/GetPredictionCandidates?id=${selectedRequestId}`);

					if (!response.ok) {

						throw new Error(
							"Tahmin adayları alınamadı.");
					}

					predictionCandidates =
						await response.json();

					predictionCandidates.forEach((candidate, index) => {
						const isTopCandidate =
							index === 0;

						const badgeClass =
							isTopCandidate
								? "text-bg-success"
								: "text-bg-primary";

						const progressClass =
							isTopCandidate
								? "bg-success"
								: "bg-primary";

						const percent =
							(candidate.score * 100)
								.toFixed(2);

						list.innerHTML +=
							`
										<div class="border rounded p-3 mb-2">

											<div class="d-flex justify-content-between">

												<strong>
													${index + 1}.
													${candidate.departmentName}
												</strong>

												<span class="badge ${badgeClass}">
													${candidate.score.toFixed(6)}
												</span>

											</div>

											<div class="text-muted small">

												${candidate.categoryName}

											</div>

											<div class="progress mt-2">
												<div class="progress-bar ${progressClass}"
														style="width:${percent}%">
												</div>

											</div>

											<small>

												${percent} %

											</small>

										</div>
										`;

						select.innerHTML +=
							`
										<option value="${candidate.categoryId}">

											${candidate.departmentName}
											/
											${candidate.categoryName}

										</option>
										`;
					});

				}

				catch (ex) {

					error.classList.remove("d-none");

					error.innerText = ex.message;
				}

				finally {

					loading.classList.add("d-none");
				}

			}

			async function assignCategory() {

				const categoryId =
					Number(
						document.getElementById(
							"candidateSelect").value);

				const response =
					await fetch(
						`/Panel/AssignRequestCategory?id=${selectedRequestId}`,
						{
							method: "PUT",

							headers: {
								"Content-Type":
									"application/json"
							},

							body: JSON.stringify({

								categoryId

							})
						});

				if (!response.ok) {

					alert("Atama başarısız.");

					return;
				}

				await loadRequests();

				await reloadSelectedRequestDetail();

				await loadPredictionCandidates();

				await loadRequestHistory();

			}

			/*
				* Returns only the Turkish status text without
				* generating a Bootstrap badge.
				*/
			function getStatusText(status) {
				const statusMap = {
					1: "Alındı",
					2: "Sınıflandırıldı",
					3: "Birime Atandı",
					4: "İşleme Alındı",
					5: "Çözüldü",
					6: "Kapatıldı",
					7: "Reddedildi"
				};

				return statusMap[status] ??
					"Bilinmeyen Durum";
			}

			function getRequesterName(request) {
				const firstName = request.requesterFirstName ?? "";
				const lastName = request.requesterLastName ?? "";
				const fullName = `${firstName} ${lastName}`.trim();

				return escapeHtml(fullName || "-");
			}

			/*
				* Opens the detail area for a selected request.
				*
				* The offcanvas detail panel will be implemented later.
				* For now, the selected request ID is written to
				* the browser console.
				*/
			function getPredictionScore(request) {
				if (request.predictionScore === null ||
					request.predictionScore === undefined) {
					return "-";
				}

				const percentage = request.predictionScore * 100;
				const formattedScore = `%${percentage.toFixed(1)}`;

				/*
				* isLowConfidence is calculated in the backend
				* by comparing PredictionScore with
				* MinimumClassificationScoreThreshold.
				*/
				if (request.isLowConfidence) {
					return `
							<span class="badge text-bg-warning">
									${formattedScore}
							</span>
							`;
				}

				return `
							<span class="badge text-bg-success">
									${formattedScore}
							</span>
							`;
			}

			/*
				* Converts the numeric RequestStatus enum value
				* into a readable Bootstrap badge.
				*
				* Backend enum:
				* 1: Received
				* 2: Classified
				* 3: Assigned
				* 4: InProgress
				* 5: Resolved
				* 6: Closed
				* 7: Rejected
				*/
			function getStatusBadge(status) {
				const statusMap = {
					1: {
						text: "Alındı",
						cssClass: "text-bg-secondary"
					},
					2: {
						text: "Sınıflandırıldı",
						cssClass: "text-bg-info"
					},
					3: {
						text: "Birime Atandı",
						cssClass: "text-bg-primary"
					},
					4: {
						text: "İşleme Alındı",
						cssClass: "text-bg-warning"
					},
					5: {
						text: "Çözüldü",
						cssClass: "text-bg-success"
					},
					6: {
						text: "Kapatıldı",
						cssClass: "text-bg-dark"
					},
					7: {
						text: "Reddedildi",
						cssClass: "text-bg-danger"
					}
				};

				const statusInfo = statusMap[status] ?? {
					text: "Bilinmiyor",
					cssClass: "text-bg-dark"
				};

				return `
								<span class="badge ${statusInfo.cssClass}">
									${statusInfo.text}
								</span>
								`;
			}

		
			/*
			* Converts the API date value into a Turkish
			* local date and time string.
			*
			* Example:
			* 2026-07-31T10:30:00
			*
			* Result:
			* 31.07.2026 10:30:00
			*/
			function formatDate(dateValue) {
				if (!dateValue) {
					return "-";
				}

				const date = new Date(dateValue);

				if (Number.isNaN(date.getTime())) {
					return "-";
				}

				return date.toLocaleString("tr-TR");
			}

			/*
				* Encodes special HTML characters.
				*
				* This prevents user-entered text from being interpreted
				* as executable HTML or JavaScript.
				*/
			function escapeHtml(value) {
				return String(value)
					.replaceAll("&", "&amp;")
					.replaceAll("<", "&lt;")
					.replaceAll(">", "&gt;")
					.replaceAll('"', "&quot;")
					.replaceAll("'", "&#039;");
			}
	</script>
}