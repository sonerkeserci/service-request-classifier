@{
    ViewData["Title"] = "Yönetim Paneli";
}

<div class="mb-4">
    <h2 class="mb-1">
        Yönetim Paneli
    </h2>

    <p class="text-muted mb-0">
        Belediye hizmet yönetim sistemine hoş geldiniz.
    </p>
</div>

<div class="row g-4">

    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <small class="text-muted">
                    Toplam Talep
                </small>

                <h2 id="totalRequestCount">
                    -
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <small class="text-muted">
                    Bekleyen Talep
                </small>

                <h2 id="pendingRequestCount">
                    -
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <small class="text-muted">
                    Personel
                </small>

                <h2 id="employeeCount">
                    -
                </h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <small class="text-muted">
                    Departman
                </small>

                <h2 id="departmentCount">
                    -
                </h2>
            </div>
        </div>
    </div>

</div>